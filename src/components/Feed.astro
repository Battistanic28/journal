---
import { getFeed } from "../../lib/getFeed";

interface ContentItem {
  channel: string;
  title: string;
  desc: string;
  link: string;
  pubDate: string;
}

interface Feed {
  [source: string]: ContentItem[];
}

const {data, lastUpdated} = await getFeed()
const feed = data as Feed;
const sources = Object.keys(feed);
---

<section>
  {
    sources.map((source) => {
      if (feed[source].length === 0) return;
      return (
        <details>
          <summary><b>{source}</b></summary>
          <ul>
            {feed[source].map((content: ContentItem) => {
              return (
                <li>
                  <i>{content.channel}:</i>
                  <a href={content.link} target="_blank">
                    {content.title}
                  </a>
                </li>
              );
            })}
          </ul>
        </details>
      );
    })
  }
  <br/>
  <i>last updated: {lastUpdated}</i>
</section>
