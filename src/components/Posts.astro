---
import { getPosts } from "../../lib/getPosts";
import { postDisplayCount } from "../content/config/config.json";

const allPosts = await getPosts();
const posts = allPosts.slice(0, postDisplayCount)
---

<section>
  ramblings
  <ul>
    {
      posts.map((p) => (
        <li>
          <a href={`/ramblings/${p.data.slug}`}>{p.data.title}</a>
          <span class="date"> -- [{p.data.published}]</span>
        </li>
      ))
    }
    {
      allPosts.length > postDisplayCount && (
        <li>
          <a href="/ramblings">more</a>
        </li>
      )
    }
  </ul>
</section>

<style>
  .date {
    color: var(--color-muted, var(--color-gray));
  }
</style>
