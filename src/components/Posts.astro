---
import { getRecentPosts } from "../../lib/getRecentPosts";

const posts = await getRecentPosts();
---

<section>
  ramblings
  <ul>
    {
      posts.map((p) => (
        <li>
          <a href={`/ramblings/${p.data.slug}`}>{p.data.title}</a>
          {` ..... [${p.data.published}]`}
        </li>
      ))
    }
  </ul>
</section>
