---
import { getRecentPosts } from "../../lib/getRecentPosts";

const posts = await getRecentPosts(5);
---

<section>
  ramblings
  <ul>
    {
      posts.map((p) => (
        <li>
          <a href={`/ramblings/${p.data.slug}`}>{p.data.title}</a>
          <span class="date"> -- [{p.data.published}]</span>
        </li>
      ))
    }
    <li><a href="/ramblings">more</a></li>
  </ul>
</section>

<style>
  .date {
    color: var(--color-muted, var(--color-gray));
  }
</style>
