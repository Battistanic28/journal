---
import { favoriteThings } from "../content/config/config.json";
const topFiveThings = favoriteThings.slice(0, 5) || [...favoriteThings];
---

<section>
  top five things
  <ul>
    {
      topFiveThings.map((thing) => (
        <li>
          <a href={thing.link}>{thing.title}</a>- {thing.description}
        </li>
      ))
    }
  </ul>
</section>
