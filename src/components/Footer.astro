---
import { footerLinks } from "../content/config/config.json";
---

<footer>
  <hr />
  <div>
    [↗]: {
      footerLinks.map((link, i) => {
        const notLast = footerLinks[i+1]
        return (
          <div class="links">
            <a target="_blank" href={link.url}>
              {link.title}
            </a>
            {notLast && <p>|</p>}
          </div>
        );
      })
    }
  </div>

  <style>
    div {
      display: flex;
      gap: 10px;
    }

    footer {
      padding-top: 3em;
    }

    hr {
      margin-bottom: 1em;
    }

  </style>
</footer>
